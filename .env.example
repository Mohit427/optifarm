# --- Backend (FastAPI) -------------------------------------------------------
# Anthropic API key. Read by the backend only; never exposed to the browser.
# Leave empty to run without AI: seed photo ID is disabled and the chatbot uses
# the offline FAQ matcher. Everything else works.
ANTHROPIC_API_KEY=
# Model used for seed vision and the assistant.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
# Requests per minute per IP for /api/seed/identify and /api/chat.
AI_RATE_LIMIT_PER_MINUTE=20
# Largest accepted seed photo, in MB.
MAX_IMAGE_MB=6
# How long a fetched forecast is reused before calling Open-Meteo again.
WEATHER_TTL_MINUTES=30
# Optional overrides (defaults shown):
# DATA_DIR=../frontend/src/data
# CACHE_DIR=./backend/.cache

# --- Frontend (Vite) ---------------------------------------------------------
# Base URL of the backend API. Defaults to /api (proxied to :8000 in dev).
# VITE_API_BASE=/api
# Where the Vite dev/preview proxy sends /api requests.
# VITE_DEV_API_TARGET=http://localhost:8000
